<?xml version="1.0"?>
<!-- ros2_control for the 7 arm joints. The Franka Hand is driven separately by
     franka_gripper_node over its own connection, as in upstream franka_ros2. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="franka_real_control" params="robot_ip use_fake_hardware">
    <ros2_control name="FrankaHardwareInterface" type="system">
      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <!-- Offline testing only: commanded positions are mirrored as states. -->
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_fake_hardware}">
          <plugin>franka_hardware/FrankaHardwareInterface</plugin>
          <param name="robot_ip">${robot_ip}</param>
        </xacro:unless>
        <!-- Franka ros2_control interface version expected by franka_hardware. -->
        <param name="version">1.0.0</param>
        <param name="robot_type">fr3</param>
        <param name="prefix"></param>
        <param name="arm_prefix"></param>
      </hardware>
      <xacro:macro name="arm_joint" params="name position">
        <joint name="${name}">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position"><param name="initial_value">${position}</param></state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>
      <xacro:arm_joint name="fr3_joint1" position="0"/>
      <xacro:arm_joint name="fr3_joint2" position="${-pi/4}"/>
      <xacro:arm_joint name="fr3_joint3" position="0"/>
      <xacro:arm_joint name="fr3_joint4" position="${-3*pi/4}"/>
      <xacro:arm_joint name="fr3_joint5" position="0"/>
      <xacro:arm_joint name="fr3_joint6" position="${pi/2}"/>
      <xacro:arm_joint name="fr3_joint7" position="${pi/4}"/>
    </ros2_control>
  </xacro:macro>
</robot>
