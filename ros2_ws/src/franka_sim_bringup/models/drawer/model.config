<?xml version="1.0"?>
<model>
  <name>drawer</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>PEARL Lab</name>
    <email>nils.dengler@tu-darmstadt.de</email>
  </author>
  <description>
    Articulated two-drawer cabinet. Meshes taken from the FurnitureBench "drawer"
    furniture (https://github.com/clvrai/furniture-bench, MIT, (c) 2023 CLVR lab @ KAIST)
    and assembled here into a single model with prismatic drawer joints and added
    centred T-knobs, a thin closed roof and a corner roof marker. Scaled 2x from
    the original, with the cabinet height reduced to 195 mm.
  </description>
</model>
