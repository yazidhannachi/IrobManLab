<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find franka_sim_bringup)/urdf/zed_x_mini_mount.generated.xacro"/>
    <joint name="zed_x_mini_mount_joint" type="fixed">
        <parent link="$(arg robot_type)_hand"/><child link="zed_x_mini_mount"/>
        <origin xyz="${zed_x_mini_mount_xyz}" rpy="0 0 ${pi}"/>
    </joint>
    <link name="zed_x_mini_mount">
        <xacro:zed_x_mini_mount_inertial/>
        <visual>
            <geometry><mesh filename="package://franka_sim_bringup/meshes/zedminixmount.stl" scale="0.001 0.001 0.001"/></geometry>
            <material name="mount_teal"><color rgba="0.04 0.52 0.57 1"/></material>
        </visual>
        <collision>
            <geometry><mesh filename="package://franka_sim_bringup/meshes/zedminixmount.stl" scale="0.001 0.001 0.001"/></geometry>
        </collision>
    </link>
    <joint name="camera_joint" type="fixed">
        <parent link="zed_x_mini_mount"/><child link="camera_link"/>
        <origin xyz="${zed_x_mini_xyz}" rpy="0 ${zed_x_mini_pitch} ${pi}"/>
    </joint>
    <!-- Keep camera_link as the cameras' Gazebo parent link. Gazebo sets the
         right camera's stereo baseline from the sensors' y offset in that link;
         lumped into fr3_link7, the -45 deg hand would shorten it. -->
    <gazebo reference="camera_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <link name="camera_link">
        <!-- 150 g camera; uniform bounding-box inertia is an approximation. -->
        <inertial>
            <mass value="0.15"/>
            <origin xyz="-0.008212796 0 0.015909009"/>
            <inertia ixx="0.000122055374" ixy="0" ixz="0"
                     iyy="0.000040739331" iyz="0" izz="0.000137485048"/>
        </inertial>
        <visual>
            <geometry><mesh filename="package://franka_sim_bringup/meshes/zed_x_mini.stl"/></geometry>
            <material name="zed_x_mini_black"><color rgba="0.09 0.10 0.12 1"/></material>
        </visual>
        <collision>
            <origin xyz="-0.008212796 0 0.015909009"/>
            <geometry><box size="0.047400002 0.093552358 0.031818018"/></geometry>
        </collision>
    </link>
    <!-- Rendering centres just ahead of the opaque CAD lens windows (x=15.487 mm).
         Nominal hardware centres in this CAD frame are (-5, +/-25, 16) mm;
         use real CameraInfo and hand-eye calibration on hardware. -->
    <joint name="left_camera_joint" type="fixed">
        <parent link="camera_link"/><child link="left_camera_link"/>
        <origin xyz="0.0156 0.025 0.016"/>
    </joint>
    <link name="left_camera_link"/>
    <joint name="left_camera_optical_joint" type="fixed">
        <parent link="left_camera_link"/><child link="left_camera_link_optical"/>
        <origin rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <link name="left_camera_link_optical"/>
    <joint name="right_camera_joint" type="fixed">
        <parent link="camera_link"/><child link="right_camera_link"/>
        <origin xyz="0.0156 -0.025 0.016"/>
    </joint>
    <link name="right_camera_link"/>
    <joint name="right_camera_optical_joint" type="fixed">
        <parent link="right_camera_link"/><child link="right_camera_link_optical"/>
        <origin rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <link name="right_camera_link_optical"/>
    <gazebo reference="left_camera_link">
        <sensor name="zed_x_mini_rgbd" type="rgbd_camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <topic>zed_x_mini/left/rgbd</topic>
            <camera>
                <horizontal_fov>${2*atan(960/737)}</horizontal_fov>
                <image>
                    <width>1920</width>
                    <height>1200</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.03</near>
                    <far>8</far>
                </clip>
                <!-- Nominal rectified 2.2 mm wide-lens HD1200 calibration (1920 x 1200).
                     Hardware uses its own per-device CameraInfo calibration. -->
                <lens>
                    <intrinsics>
                        <fx>737</fx><fy>737</fy>
                        <cx>960</cx><cy>600</cy><s>0</s>
                    </intrinsics>
                    <projection>
                        <p_fx>737</p_fx><p_fy>737</p_fy>
                        <p_cx>960</p_cx><p_cy>600</p_cy><tx>0</tx><ty>0</ty>
                    </projection>
                </lens>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <depth_camera><clip><near>0.1</near><far>8</far></clip></depth_camera>
                <optical_frame_id>left_camera_link_optical</optical_frame_id>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="right_camera_link">
        <sensor name="zed_x_mini_right" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <topic>zed_x_mini/right/image</topic>
            <camera>
                <horizontal_fov>${2*atan(960/737)}</horizontal_fov>
                <image>
                    <width>1920</width>
                    <height>1200</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.03</near>
                    <far>8</far>
                </clip>
                <!-- Nominal rectified 2.2 mm wide-lens HD1200 calibration (1920 x 1200).
                     Hardware uses its own per-device CameraInfo calibration. -->
                <lens>
                    <intrinsics>
                        <fx>737</fx><fy>737</fy>
                        <cx>960</cx><cy>600</cy><s>0</s>
                    </intrinsics>
                    <projection>
                        <p_fx>737</p_fx><p_fy>737</p_fy>
                        <p_cx>960</p_cx><p_cy>600</p_cy><tx>${-0.05*737}</tx><ty>0</ty>
                    </projection>
                </lens>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <optical_frame_id>right_camera_link_optical</optical_frame_id>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="left_camera_link">
        <sensor name="zed_x_mini_imu" type="imu">
            <pose>0 0 0 0 0 0</pose>
            <always_on>1</always_on>
            <update_rate>100</update_rate>
            <topic>zed_x_mini/imu</topic>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

</robot>
